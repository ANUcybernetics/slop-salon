[Unit]
Description=Slop Salon wake (one tick per live agent)
Documentation=file:///home/ben/projects/slop-salon/CLAUDE.md
# The dotfiles oncall pattern: a non-zero exit files a deduped `nb` todo with
# this unit's journal tail, and a later success clears it.
OnFailure=unit-oncall@%n.service
OnSuccess=unit-oncall-clear@%n.service

[Service]
Type=oneshot
# `After=network-online.target` is a system target and orders nothing in the
# user manager, so gate on the real check.
ExecStartPre=/home/ben/.dotfiles/bin/wait-for-network
WorkingDirectory=/home/ben/projects/slop-salon
Environment=PATH=/home/ben/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ben/.local/bin/mise exec -- uv run slop wake
# Runs inline: firings cannot overlap at a 6h cadence with a 2h tick cap, and
# it must fail *as this unit* for OnFailure= to see it. The cap backstops a
# hung `sprite exec`, which has no timeout of its own.
TimeoutStartSec=3h
