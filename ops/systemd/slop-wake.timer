[Unit]
Description=Trigger slop-wake on the configured cadence

[Timer]
# The installed default. Change it live with `slop cadence 6h` rather than by
# editing here: that writes a drop-in which overrides this line, and
# `slop wake-check` derives its limits from whatever is in force.
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=300
Persistent=true
Unit=slop-wake.service

[Install]
WantedBy=timers.target
