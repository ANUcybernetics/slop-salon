#!/usr/bin/env bash
# slop-tick: run one tick of the agent.
#
# Called by `slop wake` (with the prompt "tick") or `slop talk` (with an admin
# prompt), via `sprite exec`. Everything it needs arrives in the environment:
# AGENT_NAME, the runner, `agent-run` profile and model, the model's
# credential, and the tick's secrets (BSKY_PASSWORD, GH_TOKEN,
# REPLICATE_API_TOKEN). Nothing is read from disk but this repo. Stateless:
# pull, run the agent once, commit and push.
set -euo pipefail

: "${AGENT_NAME:?AGENT_NAME not set}"
if [[ $# -lt 1 ]]; then
  echo 'usage: slop-tick "<prompt>"' >&2
  exit 1
fi

cd "$HOME/slop-salon-$AGENT_NAME"

# Commit leftovers from a tick that died mid-run before pulling, so the rebase
# replays them cleanly instead of refusing to overwrite untracked files.
if ! git diff --quiet HEAD || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
  git add -A
  git commit -q -m "session $(date -Iseconds) (pre-tick leftovers)"
fi
git pull --rebase --quiet

# `agent-run` owns the auth boundary and spells the call for the runner; its
# options are per-runner, and it refuses one meant for the other.
RUNNER="${SLOP_RUNNER:-claude}"
RUN=(agent-run --profile "${AGENT_PROFILE:?AGENT_PROFILE not set}" --cwd "$PWD" --bypass-permissions)
case "$RUNNER" in
claude)
  # AskUserQuestion is taken away rather than discouraged: nobody is there to
  # answer.
  RUN+=(--claude-disallowed-tools "${SLOP_DENIED_TOOLS:-AskUserQuestion}" "$1")
  ;;
codex)
  # Codex reads AGENTS.md and has no `@` imports, so inline them (gitignored,
  # rewritten every tick). A stale one beats no tick.
  slop-prompt agents-md --root "$PWD" || echo "slop-tick: slop-prompt failed, AGENTS.md may be stale" >&2
  # Codex logs in from a file; it exists only for the life of this tick.
  mkdir -p "$HOME/.codex"
  (umask 077 && base64 -d <<<"${SLOP_CODEX_AUTH:?SLOP_CODEX_AUTH not set}" >"$HOME/.codex/auth.json")
  trap 'rm -f "$HOME/.codex/auth.json"' EXIT
  unset SLOP_CODEX_AUTH
  RUN+=("$1")
  # CLAUDE_CODE_SHELL_PREFIX caps each claude tool command's memory; codex has
  # no such hook, so the cap goes on codex and everything it spawns.
  if [[ -n "${CLAUDE_CODE_SHELL_PREFIX:-}" ]]; then
    RUN=("$CLAUDE_CODE_SHELL_PREFIX" "$(printf '%q ' "${RUN[@]}")")
  fi
  ;;
*)
  echo "slop-tick: unknown SLOP_RUNNER '$RUNNER' (want claude or codex)" >&2
  exit 1
  ;;
esac

# A hard wall-clock cap so a wedged tick cannot stall the wake driver, set well
# past any healthy tick: nobody waits on one finishing. On hit the run is killed (timeout exit 124). Stdin is closed: `sprite exec` leaves it
# open, and codex waits on an open stdin for more prompt until the cap.
TICK_TIMEOUT="${SLOP_TICK_TIMEOUT:-4h}"
rc=0
timeout --kill-after=15 "$TICK_TIMEOUT" "${RUN[@]}" </dev/null || rc=$?
if [[ $rc -eq 124 ]]; then
  echo "slop-tick: $RUNNER exceeded ${TICK_TIMEOUT}, killed" >&2
elif [[ $rc -ne 0 ]]; then
  echo "slop-tick: $RUNNER exited $rc" >&2
fi

# Reap orphan BashTool shells claude leaves behind (they are session leaders).
pkill -f "shell-snapshots/snapshot-zsh" 2>/dev/null || true

if ! git diff --quiet HEAD || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
  git add -A
  git commit -q -m "session $(date -Iseconds)"
  git push --quiet
fi
