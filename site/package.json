{
  "name": "slop-salon-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm build:embed",
    "build:embed": "vite build --config vite.embed.config.ts",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "astro": "^6.3.5",
    "hls.js": "^1.6.16",
    "markdown-it": "^14.1.1",
    "masonry-pf": "^1.1.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@e18e/eslint-plugin": "^0.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
